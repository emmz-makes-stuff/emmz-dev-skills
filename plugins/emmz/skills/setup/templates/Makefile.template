#!! TEMPLATE: ./Makefile. Fill every {{PLACEHOLDER}}, then DELETE every line starting with `#!!`.
#!! Plain `#` comments are part of the generated file — keep them.
#!! RECIPE LINES MUST START WITH A LITERAL TAB.
#!! Delete any target the project genuinely has no command for (e.g. no separate linter) — but a gate
#!! you can't derive is confirmed with the user, never silently dropped.
# {{PROJECT_NAME}} — gate targets.
#
# Every gate prints its own exit code as `LABEL_EXIT:<n>` and exits with it, so a
# result can be quoted rather than inferred from output that may look clean.
# `gates` runs the whole set with -k, so one run reports every failure.

SHELL := /bin/bash

CHANGES := $(notdir $(patsubst %/,%,$(filter-out %/archive/,$(wildcard openspec/changes/*/))))

.PHONY: {{PHONY_LIST}}

build:
	@{{BUILD_CMD}}; code=$$?; echo "BUILD_EXIT:$$code"; exit $$code

test:
	@{{TEST_CMD}}; code=$$?; echo "TEST_EXIT:$$code"; exit $$code

format:
	@{{FORMAT_CHECK_CMD}}; code=$$?; echo "FORMAT_EXIT:$$code"; exit $$code

lint:
	@{{LINT_CMD}}; code=$$?; echo "LINT_EXIT:$$code"; exit $$code

#!! MULTI-STACK: add a prefixed block per extra stack, labels prefixed to match:
#!!   web-build:
#!!   <TAB>@npm --prefix web run build; code=$$?; echo "WEB_BUILD_EXIT:$$code"; exit $$code
#!! and include those targets in `gates` below.

# Validates every active change. No active change is a failure, not a silent pass.
validate:
	@fail=0; \
	if [ -z "$(CHANGES)" ]; then \
		echo "no active change found under openspec/changes/"; fail=1; \
	else \
		for c in $(CHANGES); do openspec validate $$c --strict || fail=1; done; \
	fi; \
	echo "VALIDATE_EXIT:$$fail"; exit $$fail

changes:
	@echo "$(CHANGES)"

gates:
	@$(MAKE) --no-print-directory -k {{GATE_TARGETS}}; code=$$?; \
	echo "GATES_EXIT:$$code"; exit $$code
#!! {{GATE_TARGETS}} = every gate target above plus `validate`, e.g. `build test format validate`.

# Every tool and login in docs/dependencies.md — keep the two in step. Not part of
# `gates`: it checks the machine, not the code, and auth checks may need the network.
deps:
	@fail=0; \
	{{DEP_CHECKS}}
	echo "DEPS_EXIT:$$fail"; exit $$fail
#!! {{DEP_CHECKS}} = one line per docs/dependencies.md row, each ending `; \` and indented with a TAB:
#!!   <TAB>dotnet --version >/dev/null 2>&1 || { echo "MISSING dotnet — brew install dotnet"; fail=1; }; \
#!!   <TAB>gh --version >/dev/null 2>&1 || { echo "MISSING gh — brew install gh"; fail=1; }; \
#!!   <TAB>gh auth status >/dev/null 2>&1 || { echo "NOT AUTHENTICATED gh — gh auth login"; fail=1; }; \
#!! Auth checks get their own line so a missing login is reported separately from a missing tool.
#!! Where Version matters, check it too, e.g.
#!!   <TAB>dotnet --version 2>/dev/null | grep -q '^10\.' || { echo "WRONG VERSION dotnet — need 10.x"; fail=1; }; \
